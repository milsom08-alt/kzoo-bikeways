    <LineString>
     <tessellate>1</tessellate>
     <coordinates>-85.53113,42.15742,0 -85.52875,42.15079,0</coordinates>
    </LineString>
   </Placemark>
   <Placemark>
    <name>East Central Trail SUP (new 2025)</name>
    <description>&lt;b&gt;Status (as of Oct 14, 2026):&lt;/b&gt; Open – ribbon cutting May 16, 2025.&lt;br&gt;&lt;b&gt;Facility:&lt;/b&gt; Paved shared-use path with boardwalk, ~1 mi&lt;br&gt;Runs between Portage Rd and Lovers Ln, linking the Lake Center District with Celery Flats. Line from the KATS October 2026 facilities layer.&lt;br&gt;&lt;b&gt;Sources:&lt;/b&gt;&lt;br&gt;&lt;a href="https://www.portagemi.gov/CivicAlerts.aspx?AID=1546&amp;ARC=2254"&gt;City of Portage – East Central Trail Ribbon Cutting (May 2025)&lt;/a&gt;&lt;br&gt;&lt;a href="https://services8.arcgis.com/iMB25Rg6ZW5ZL5YH/arcgis/rest/services/Existing_Facilities_October_2026/FeatureServer/0"&gt;KATS Existing Facilities October 2026 (ArcGIS layer, edited Oct 7, 2026)&lt;/a&gt;</description>
